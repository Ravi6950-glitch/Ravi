# ---------------------------------------------------------------------------
# Chorus configuration
# Copy to .env and fill in what you need. Chorus runs fully without any of the
# optional keys - connected accounts fall back to Sandbox mode.
# ---------------------------------------------------------------------------

# Database (SQLite by default; point at Postgres for production)
DATABASE_URL="file:./chorus.db"

# Secret used to sign session cookies and encrypt stored platform tokens.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL - used to build OAuth redirect URIs.
APP_URL="http://localhost:3000"

# --- AI agents -------------------------------------------------------------
# Without a key the agents run on the built-in heuristic engine (no network).
# With a key they run on Claude and produce far richer analysis.
ANTHROPIC_API_KEY=""
CHORUS_AI_MODEL="claude-opus-5-5"
CHORUS_AI_EFFORT="medium"           # low | medium | high | xhigh | max

# --- Background worker -----------------------------------------------------
CHORUS_WORKER_ENABLED="true"
CHORUS_WORKER_TICK_SECONDS="30"

# --- Platform credentials (all optional) -----------------------------------
# Any platform without credentials can still be connected in Sandbox mode so
# you can build and test the whole workflow. Fill these in to publish for real.

# Meta (Instagram, Facebook Pages, Threads)
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# X (Twitter)
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube / Google Business Profile
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pinterest
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# Reddit
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Snapchat
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# Tumblr
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""

# Twitch
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Discord (bot token for channel posting)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Platforms that only need a per-account token, entered in the UI when you
# connect them (no app registration required): Mastodon, Bluesky, Telegram,
# Discord webhooks, Ghost, Dev.to, Hashnode, WordPress.
