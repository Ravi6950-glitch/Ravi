{
  "name": "chorus",
  "version": "1.0.0",
  "private": true,
  "description": "Chorus - the multi-platform social command center. Connect every network, schedule everything, and let AI agents watch your performance around the clock.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/chorus.db && prisma db push && npm run db:seed",
    "setup": "npm install && prisma generate && prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@prisma/client": "6.1.0",
    "jose": "5.9.6",
    "next": "16.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prisma": "6.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
